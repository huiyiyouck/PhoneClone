# 生产环境配置文件模板
# 复制此文件为 application-production.yml，然后填写实际配置
# 注意：application-production.yml 已在 .gitignore 中，不会提交到GitHub

spring:
  datasource:
    # Supabase数据库连接信息
    # 从Supabase项目设置中获取：
    # 1. 访问 https://supabase.com/dashboard
    # 2. 选择你的项目
    # 3. Settings → Database → Connection string
    url: jdbc:postgresql://db.dzxunppummwzfkdhlelh.supabase.co:5432/postgres?user=postgres&password=cqcet.19981025CK
    #username: postgres
    #password: 你的Supabase数据库密码
    
    # 连接池配置
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 30000
  
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
  
  security:
    jwt:
      # JWT密钥（至少32字符）
      # 生成命令：openssl rand -base64 32
      secret: 请替换为你的JWT密钥（至少32字符）
      expiration: 86400000  # 24小时（毫秒）

server:
  port: 8080
  servlet:
    context-path: /api

logging:
  level:
    com.phoneclone: INFO
    org.springframework.security: WARN
    org.springframework.web: INFO

